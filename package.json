{
  "name": "careertrack-workspace",
  "version": "1.0.0",
  "description": "CareerTrack - Full-Stack Job Application Tracker",
  "scripts": {
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "backend:start": "npm --prefix backend start",
    "backend:dev": "npm --prefix backend run dev",
    "backend:seed": "npm --prefix backend run seed",
    "backend:test": "npm --prefix backend run test",
    "frontend:start": "npm --prefix frontend start",
    "frontend:build": "npm --prefix frontend run build",
    "seed": "node backend/seed.js",
    "test": "node backend/run-and-test.js"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.3.4"
  },
  "keywords": [
    "angular",
    "express",
    "mongodb",
    "job-tracker"
  ],
  "author": "CareerTrack",
  "license": "MIT",
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.65.1"
  }
}
